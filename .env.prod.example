# Production env file. Lives on the server at /opt/devforge/devforge-be/.env,
# chmod 600, owned by the user that runs compose. Never committed with real
# values — CI writes it from GitHub Secrets on every deploy.
#
# Copy this, fill the blanks, then: chmod 600 .env

# COMPOSE_PROFILES is deliberately absent: it is what gates mailpit, and a mail
# catcher on a public box is a mailbox anyone can read.

DOMAIN=example.com
ACME_EMAIL=you@example.com

APP_ENV=production
PORT=8080
LOG_LEVEL=info

DB_HOST=postgres
DB_PORT=5432
DB_USER=devforge
DB_PASSWORD=
DB_NAME=devforge
# sslmode=disable is correct here and only here: this never leaves the compose
# bridge, and Postgres publishes no port outside the box.
DATABASE_URL=postgres://devforge:@postgres:5432/devforge?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Same origin as the FE, so this is close to dead weight in production — kept
# because the value is what the WebSocket origin check reads.
CORS_ORIGINS=https://example.com
# Empty = host-only cookie. Correct for one domain; only set this if the FE and
# API ever move to different subdomains.
COOKIE_DOMAIN=

# MANDATORY, see README §9.5. Caddy reaches the API across the compose bridge,
# so Gin sees a 172.x address as the peer. Leave this at the dev default and
# X-Forwarded-For is discarded: PUBLIC_RATE_LIMIT stops being per-address and
# becomes 60/min for the entire internet, and every audit row records Caddy's
# container IP.
#
# Only this wide because the API publishes no port and Caddy is the sole way
# in. Never 0.0.0.0/0 — that lets any caller pick their own address.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

JWT_SECRET=
ACCESS_TTL=15m
REFRESH_TTL=168h

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://example.com/api/auth/google/callback
FRONTEND_URL=https://example.com
# The origin, with NO /api on the end. Both users of this value append their
# own path: upload.Saver builds PUBLIC_URL + "/uploads/..." (a root route) and
# the share-preview handler builds PUBLIC_URL + "/api/shared-drills/...".
# Appending /api here gives /api/uploads, which no route serves.
PUBLIC_URL=https://example.com
# Matches the named volume mounted in docker-compose.prod.yml. The distroless
# image runs as nonroot and cannot write ./uploads next to the binary.
UPLOAD_DIR=/uploads

# Resend (3000/month) or Brevo (300/day). Only verification codes and password
# resets go through here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

VERIFY_CODE_TTL=10m
RESET_TOKEN_TTL=1h
RESEND_COOLDOWN=60s

# Overridden by docker-compose.prod.yml to tcp://docker-proxy:2375 — inside a
# container, loopback is the container itself.
LAB_DOCKER_HOST=tcp://docker-proxy:2375
# 30m, not the 60m of development. Four cores seat roughly eight busy
# containers; halving the lease doubles the seat turnover (README §9.4).
LAB_SESSION_TTL=30m
MAX_CONTAINERS=40
PUBLIC_RATE_LIMIT=60

# EMPTY ON PURPOSE for the first deploy. Missing key or missing model disables
# the feature: that one endpoint answers 503 and the server runs normally.
# AI is the only line item that can outspend the server — at the hard cap with
# opus-5 it reaches tens of millions of dong a month (README §9.6). Fill this
# in only after watching one real day of usage.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4-5
AI_DAILY_LIMIT=3

# Backup, see scripts/backup.sh. Cloudflare R2: 10 GB and zero egress on the
# free plan. Retention is an R2 lifecycle rule, not code.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
