# Production env file. Lives on the server at /opt/devforge/devforge-be/.env,
# chmod 600, owned by the user that runs compose. Never committed with real
# values, and never shipped by CD either — the deploy job is an ssh and nothing
# else (INFRA.md §8). This file is filled in by hand, once, on the box.
#
# Copy this, fill the blanks, then: chmod 600 .env

# COMPOSE_PROFILES is deliberately absent: it is what gates mailpit, and a mail
# catcher on a public box is a mailbox anyone can read.

# Which box this is. Nothing in the edge reads it — nginx answers on
# `server_name _` and the hostname comes from DNS — but deploy/up.sh refuses to
# run without it, so an unlabelled box cannot be deployed to by accident.
#
# No ACME_EMAIL: TLS is a Cloudflare Origin Certificate sitting in
# deploy/nginx/certs/, not a certificate anything asks for at startup.
DOMAIN=example.com

# Where deploy/up.sh pulls the api and web images from. Owner must be lowercase
# — GHCR rejects anything else — and the package has to be set Public once in
# the GitHub UI, or the box needs a PAT just to pull its own release.
#
# IMAGE_TAG is NOT set here. It is passed per deploy (IMAGE_TAG=v1.2.0
# ./deploy/up.sh) and written to .image-tag on success, so the file always
# describes the box rather than a version someone edited months ago.
IMAGE_REPO=ghcr.io/tuql3

APP_ENV=production
PORT=8080
LOG_LEVEL=info

DB_HOST=postgres
DB_PORT=5432
DB_USER=devforge
DB_PASSWORD=
DB_NAME=devforge
# sslmode=disable is correct here and only here: this never leaves the compose
# bridge, and Postgres publishes no port outside the box.
# Interpolated, not spelled out a second time: up.sh and backup.sh source this
# file with `set -a` in bash, so DB_USER/DB_PASSWORD/DB_NAME above are the only
# place to edit. Writing the password here as well is how migrate ends up
# authenticating with a stale one on a box nobody is watching. Nothing in the
# Go binary reads this — only migrate and the Makefile do.
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Same origin as the FE, so this is close to dead weight in production — kept
# because the value is what the WebSocket origin check reads.
CORS_ORIGINS=https://example.com
# Empty = host-only cookie. Correct for one domain; only set this if the FE and
# API ever move to different subdomains.
COOKIE_DOMAIN=

# MANDATORY, see INFRA.md §9.5. nginx reaches the API across the compose bridge,
# so Gin sees a 172.x address as the peer. Leave this at the dev default and
# X-Forwarded-For is discarded: PUBLIC_RATE_LIMIT stops being per-address and
# becomes 60/min for the entire internet, and every audit row records nginx's
# container IP.
#
# This is only half the job. The other half is in deploy/nginx/devforge.conf:
# without set_real_ip_from + real_ip_header CF-Connecting-IP there, the address
# nginx forwards is a Cloudflare edge node and both symptoms happen anyway.
#
# Only this wide because the API publishes no port and nginx is the sole way
# in. Never 0.0.0.0/0 — that lets any caller pick their own address.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

JWT_SECRET=
ACCESS_TTL=15m
REFRESH_TTL=168h

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://example.com/api/auth/google/callback
FRONTEND_URL=https://example.com
# The origin, with NO /api on the end. Both users of this value append their
# own path: upload.Saver builds PUBLIC_URL + "/uploads/..." (a root route) and
# the share-preview handler builds PUBLIC_URL + "/api/shared-drills/...".
# Appending /api here gives /api/uploads, which no route serves.
PUBLIC_URL=https://example.com
# Matches the named volume mounted in docker-compose.prod.yml. The distroless
# image runs as nonroot and cannot write ./uploads next to the binary.
UPLOAD_DIR=/uploads

# Resend (3000/month) or Brevo (300/day). Only verification codes and password
# resets go through here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

VERIFY_CODE_TTL=10m
RESET_TOKEN_TTL=1h
RESEND_COOLDOWN=60s

# Overridden by docker-compose.prod.yml to tcp://docker-proxy:2375 — inside a
# container, loopback is the container itself.
LAB_DOCKER_HOST=tcp://docker-proxy:2375
# 20m, not the 60m of development, and the seat cap is 12 rather than 40: this
# is 2 vCPU, which seats about four busy containers at once. A shorter lease is
# the lever that turns seats over faster, and it costs nothing (INFRA.md §9.4).
# Too slow under real load → lower MAX_CONTAINERS to 8. Never raise it; the
# right knob for more users is a bigger box.
LAB_SESSION_TTL=20m
MAX_CONTAINERS=12
PUBLIC_RATE_LIMIT=60

# EMPTY ON PURPOSE for the first deploy. Missing key or missing model disables
# the feature: that one endpoint answers 503 and the server runs normally.
# AI is the only line item that can outspend the server — at the hard cap with
# opus-5 it reaches tens of millions of dong a month (INFRA.md §9.6). Fill this
# in only after watching one real day of usage.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4-5
AI_DAILY_LIMIT=3

# Backup, see scripts/backup.sh. Cloudflare R2: 10 GB and zero egress on the
# free plan. Retention is an R2 lifecycle rule, not code.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# STAGING — same file, these lines different
#
# Staging is a second VPS (§8 "Staging"), so it copies this template and edits
# exactly the lines below. There is deliberately no .env.staging.example: two
# hundred-line templates drift apart, and the half that drifts is always the one
# nobody deploys often.
#
#   DOMAIN=staging.example.com
#   PUBLIC_URL=https://staging.example.com
#   FRONTEND_URL=https://staging.example.com
#   CORS_ORIGINS=https://staging.example.com
#   GOOGLE_REDIRECT_URL=https://staging.example.com/api/auth/google/callback
#       ^ register this second URI in Google Console too, or OAuth dies here only
#
#   MAX_CONTAINERS=4          # smaller box; the seat cap is per database (§8)
#   LAB_SESSION_TTL=10m       # shorter lease, faster turnover for QA
#   OPENROUTER_API_KEY=       # EMPTY. Do not burn AI budget rehearsing
#   AI_DAILY_LIMIT=0
#
#   R2_BUCKET=                # EMPTY — staging is not backed up, on purpose
#
#   COMPOSE_PROFILES=dev      # brings up mailpit as the SMTP sink
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
#   SMTP_USER=
#   SMTP_PASSWORD=
#
# ⚠️ mailpit publishes on 127.0.0.1 only (docker-compose.yml), so its inbox is
# reachable from the staging box itself and through an ssh tunnel, and from
# nowhere else:
#
#   ssh -L 8025:127.0.0.1:8025 <user>@<staging host>   # then open localhost:8025
#
# Never change that binding to 0.0.0.0. A mail catcher on a public address is a
# mailbox anyone can read, and it holds verification codes and reset links.
