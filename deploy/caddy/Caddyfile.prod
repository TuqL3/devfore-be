# Production edge. One domain, routed by path (INFRA.md §8): no CORS, one cert.
# DOMAIN and ACME_EMAIL come from the env file through compose.
#
# The A record must already point at this box before the first `up`, or the
# HTTP-01 challenge fails and Caddy retries into a Let's Encrypt rate limit.
{
	email {$ACME_EMAIL}
	admin off
}

{$DOMAIN} {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /healthz {
		reverse_proxy api:8080
	}

	handle /readyz {
		reverse_proxy api:8080
	}

	# Cover images and avatars. This one is easy to miss: the route is
	# r.Static("/uploads", ...) on the root router, NOT inside the /api group,
	# and upload.Saver builds its URLs as PUBLIC_URL + "/uploads/" + name. Route
	# only /api here and every uploaded image resolves to the SPA's index.html.
	handle /uploads/* {
		reverse_proxy api:8080
	}

	# Lab terminals hold a WebSocket open for the whole session. No short
	# timeout here, and no flush interval either — xterm.js is keystroke-latency
	# bound and buffering is what makes a remote shell feel broken.
	handle /ws/* {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	# Facebook/X/Slack/Zalo crawlers do not run JavaScript and the app is an
	# SPA, so a shared link pasted anywhere renders a blank box. Send just
	# those to an endpoint that returns HTML with the og:* tags already in it;
	# real people still get the app.
	#
	# Must sit BEFORE the catch-all `handle` below: Caddy runs handle blocks in
	# written order and the catch-all swallows every path.
	@crawler {
		path_regexp share ^/r/([A-Za-z0-9_-]+)/?$
		header_regexp User-Agent "(?i)(facebookexternalhit|twitterbot|slackbot|discordbot|telegrambot|linkedinbot|whatsapp|zalo|skypeuripreview|embedly|quora link preview|pinterest|redditbot|bingbot|googlebot)"
	}
	handle @crawler {
		rewrite * /api/shared-drills/{re.share.1}/preview
		reverse_proxy api:8080
	}

	@daycrawler {
		path_regexp day ^/war-room/day/(\d{4}-\d{2}-\d{2})/?$
		header_regexp User-Agent "(?i)(facebookexternalhit|twitterbot|slackbot|discordbot|telegrambot|linkedinbot|whatsapp|zalo|skypeuripreview|embedly|quora link preview|pinterest|redditbot|bingbot|googlebot)"
	}
	handle @daycrawler {
		rewrite * /api/daily-drill/{re.day.1}/preview
		reverse_proxy api:8080
	}

	# The FE image is caddy:2-alpine serving the built SPA on :80, not the Vite
	# dev server on :5173 that the development Caddyfile talks to.
	handle {
		reverse_proxy web:80
	}
}
