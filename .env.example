# Turns on the dev-only services in docker-compose.yml (mailpit). Production's
# env file leaves this out, so those services never start there.
COMPOSE_PROFILES=dev

DB_USER=devforge
DB_PASSWORD=devforge_local_only
DB_NAME=devforge

APP_ENV=development
PORT=8080
LOG_LEVEL=debug
DB_HOST=localhost
DB_PORT=5432
CORS_ORIGINS=http://localhost:5173

# Whose X-Forwarded-For the server believes. Everything that identifies a caller
# reads the address this produces: the per-address rate limit on the public share
# routes (PUBLIC_RATE_LIMIT), audit_logs.ip, and the logged-in-devices screen.
#
# Loopback only here, which is right for development: nothing sits in front of
# the API, so no forwarding header should be trusted.
#
# In PRODUCTION this must name the proxy, or every request arrives wearing the
# proxy's address — one visitor to a shared link then drains the rate limit for
# everyone, and every audit row records the same IP. nginx reaches the API across
# the compose bridge, so:
#
#   TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
#
# Only widen it that far when the API publishes no port of its own and nginx is
# the sole way in. Never set 0.0.0.0/0: trusting every peer lets any caller pick
# their own address by sending the header.
TRUSTED_PROXIES=127.0.0.1,::1

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# Empty = host-only cookie. Set only when FE and API sit on different subdomains.
COOKIE_DOMAIN=

DATABASE_URL=postgres://devforge:devforge_local_only@localhost:5432/devforge?sslmode=disable

JWT_SECRET=dev_only_change_me
ACCESS_TTL=15m
REFRESH_TTL=168h
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:8080

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@devforge.local

VERIFY_CODE_TTL=10m
RESET_TOKEN_TTL=1h
RESEND_COOLDOWN=60s

# Lab runtime. Points at the docker-socket-proxy service from docker-compose,
# never at /var/run/docker.sock. Deliberately not called DOCKER_HOST: that name
# is read by the docker CLI as well, and `source .env` would then send your own
# docker commands through a proxy that denies most of them.
LAB_DOCKER_HOST=tcp://127.0.0.1:2375
LAB_SESSION_TTL=60m

# Nhờ AI dựng kịch bản mô phỏng, qua OpenRouter. Thiếu key HOẶC thiếu model thì
# tính năng tắt, server vẫn chạy bình thường và riêng endpoint đó trả 503.
#
# Model: dán slug từ https://openrouter.ai/models — phải là model có hỗ trợ
# response_format (structured outputs), nếu không request sẽ bị từ chối định
# tuyến. Không có giá trị mặc định: một slug gõ cứng mà upstream đổi tên sẽ hỏng
# thành 404 khó hiểu đúng lúc ai đó bấm nút lần đầu.
#
# Mỗi lượt sinh là một request tính tiền — AI_DAILY_LIMIT là trần cứng mỗi người
# mỗi ngày (UTC). Nâng lên sau khi đã nhìn thấy một ngày tốn bao nhiêu.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5
AI_DAILY_LIMIT=10

# Only for `make release`: where the dev box answers ssh, so the release can read
# which commits dev is serving (INFRA.md §13.11). The box itself never reads it.
DEV_SSH=
